{
  "name": "expert-learning-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Expert Learning & Consultation Platform - Monorepo",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:server": "turbo run dev --filter=@repo/server",
    "dev:mobile": "turbo run dev --filter=@repo/mobile",
    "dev:imagehandler": "turbo run dev --filter=@repo/imagehandler",
    "build": "turbo run build",
    "check": "turbo run check",
    "test": "turbo run test",
    "db:up": "docker-compose up -d postgres",
    "db:down": "docker-compose down",
    "db:seed": "pnpm --filter @repo/server db:seed",
    "db:push": "pnpm --filter @repo/server db:push",
    "format": "biome format --write .",
    "lint": "biome lint ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
